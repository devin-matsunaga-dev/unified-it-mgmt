<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.4.6" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>it-platform-apphost-development</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.5.3" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.5.3" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" Version="13.5.3" />
    <PackageReference Include="Aspire.Hosting.Redis" Version="13.5.3" />
    <PackageReference Include="MessagePack" Version="3.1.8" />
    <PackageReference Include="StackExchange.Redis" Version="3.1.31" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referenced for its code, not as a resource to orchestrate: AppHost renders the RabbitMQ
         definitions with the same renderer the tests import into a throwaway broker. -->
    <ProjectReference Include="..\Platform\Platform.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\Seeder\Seeder.csproj" />
    <ProjectReference Include="..\Web.Host\Web.Host.csproj" />
  </ItemGroup>

</Project>
