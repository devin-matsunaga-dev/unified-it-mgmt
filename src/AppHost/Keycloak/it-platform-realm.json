{
  "realm": "it-platform",
  "enabled": true,
  "displayName": "IT Platform",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "roles": {
    "realm": [
      { "name": "Admin" },
      { "name": "Technician" },
      { "name": "Manager" },
      { "name": "EndUser" }
    ]
  },
  "clients": [
    {
      "clientId": "it-platform-api",
      "name": "IT Platform API",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "it-platform-web",
      "name": "IT Platform Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "API audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "it-platform-api",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    { "username": "admin1", "enabled": true, "emailVerified": true, "email": "admin1@example.test", "firstName": "Admin", "lastName": "One", "credentials": [{ "type": "password", "value": "ChangeMe-Admin1!", "temporary": false }], "realmRoles": ["Admin"] },
