      "protocol": "openid-connect",
      "redirectUris": ["http://localhost:5173/*", "http://${PUBLIC_HOST}:5173/*"],
      "webOrigins": ["http://localhost:5173", "http://${PUBLIC_HOST}:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
