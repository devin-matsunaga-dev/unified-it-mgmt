    { "username": "technician1", "enabled": true, "emailVerified": true, "email": "technician1@example.test", "firstName": "Technician", "lastName": "One", "credentials": [{ "type": "password", "value": "ChangeMe-Technician1!", "temporary": false }], "realmRoles": ["Technician"] },
    { "username": "technician2", "enabled": true, "emailVerified": true, "email": "technician2@example.test", "firstName": "Technician", "lastName": "Two", "credentials": [{ "type": "password", "value": "ChangeMe-Technician2!", "temporary": false }], "realmRoles": ["Technician"] },
    { "username": "manager1", "enabled": true, "emailVerified": true, "email": "manager1@example.test", "firstName": "Manager", "lastName": "One", "credentials": [{ "type": "password", "value": "ChangeMe-Manager1!", "temporary": false }], "realmRoles": ["Manager"] },
