<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="MassTransit.EntityFrameworkCore" Version="9.2.3" />
    <PackageReference Include="MassTransit.RabbitMQ" Version="9.2.3" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="4.5.1" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="FluentValidation" Version="12.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- WP-3.5: alert state machines live in Redis (ARCHITECTURE §5). The host already carries this
         transitively through Aspire.StackExchange.Redis; naming it here is what lets the module hold
         an IConnectionMultiplexer without depending on how the host acquired one. -->
    <PackageReference Include="StackExchange.Redis" Version="3.4.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Platform/Platform.csproj" />
  </ItemGroup>

</Project>
